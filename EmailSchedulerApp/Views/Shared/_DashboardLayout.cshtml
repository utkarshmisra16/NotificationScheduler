<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Email Scheduler — MailFlow</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/Dashboard/DashboardLayout.css" />
    <style>
        
    </style>
</head>

<body>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Mobile Sidebar (Offcanvas) -->
    <div class="offcanvas offcanvas-start bg-sidebar"
         tabindex="-1"
         id="mobileSidebar"
         style="width: 240px;">
        <div class="offcanvas-header" style="border-bottom: 1px solid #1e2130; padding: 0;">
            <button type="button"
                    class="btn-close btn-close-white ms-auto me-2 mt-2"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            @await Html.PartialAsync("_Sidebar")
        </div>
    </div>

    <!-- Main Layout Shell -->
    <div class="layout-shell">
        <!-- Desktop Sidebar -->
        <div class="layout-sidebar d-none d-md-block">
            @await Html.PartialAsync("_Sidebar")
        </div>

        <!-- Right: TopBar + Content -->
        <div class="layout-main">
            @await Html.PartialAsync("_TopBar")
            <div class="layout-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Dashboard/Dashboard.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
