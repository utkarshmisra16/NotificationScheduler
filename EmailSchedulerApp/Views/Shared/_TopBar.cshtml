<link rel="stylesheet" href="~/css/topbar.css" />
<div class="topbar">
    <div class="topbar-left">
        <button class="topbar-mobile-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
            <i class="bi bi-list fs-5"></i>
        </button>
        <div class="topbar-breadcrumb">
            <i class="bi bi-house" style="font-size:13px;"></i>
            <i class="bi bi-chevron-right" style="font-size:10px;"></i>
            <span>Dashboard</span>
        </div>
    </div>

    <div class="topbar-right">
        <a href="#" class="topbar-icon-btn" title="Search">
            <i class="bi bi-search"></i>
        </a>

        <a href="#" class="topbar-icon-btn" title="Notifications">
            <i class="bi bi-bell"></i>
            <span class="notif-dot"></span>
        </a>

        <div class="topbar-divider"></div>

        <div class="dropdown">
            <a class="topbar-user-btn" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="topbar-user-avatar">A</div>
                <span class="topbar-user-name">Admin</span>
                <i class="bi bi-chevron-down"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="bi bi-person"></i> Profile
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="bi bi-gear"></i> Settings
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item text-danger" href="#" id="logoutBtn">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<form id="logoutForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<script src="~/js/Auth/logout.js"></script>