@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="templates-page">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h5 class="templates-title mb-1">Email Templates</h5>
            <span class="templates-subtitle">
                View and manage all your email templates
            </span>
        </div>

        <button type="button" class="btn btn-primary templates-add-btn">
            <i class="fa fa-plus mr-1"></i>
            New Template
        </button>

    </div>


    <!-- Main Card -->
    <div class="templates-card">

        <!-- Top toolbar -->
        <div class="templates-toolbar">

            <div class="templates-toolbar-left">

                <div class="templates-search">
                    <i class="fa fa-search"></i>
                    <input type="text" placeholder="Search templates..." />
                </div>

                <button type="button" class="templates-filter">
                    <i class="fa fa-filter mr-1"></i>
                    Filter
                </button>

            </div>

            <div class="templates-count">
                <span>24</span> Templates
            </div>

        </div>


        <!-- Table -->
        <div class="templates-table-container">

            <table class="templates-table">

                <thead>
                    <tr>
                        <th>Template</th>
                        <th>Subject</th>
                        <th>Created By</th>
                        <th>Created On</th>
                        <th>Status</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>
                            <div class="template-cell">

                                <div class="template-avatar">
                                    <i class="fa fa-envelope-o"></i>
                                </div>

                                <div>
                                    <div class="template-name">
                                        Welcome Email
                                    </div>

                                    <div class="template-description">
                                        Welcome email template
                                    </div>
                                </div>

                            </div>
                        </td>

                        <td>
                            <span class="template-subject">
                                Welcome to our application
                            </span>
                        </td>

                        <td>
                            <span class="template-user">
                                Admin
                            </span>
                        </td>

                        <td>
                            <span class="template-date">
                                02 Aug 2026
                            </span>
                        </td>

                        <td>
                            <span class="template-status active">
                                <span></span>
                                Active
                            </span>
                        </td>

                        <td>
                            <div class="template-actions">

                                <button title="View">
                                    <i class="fa fa-eye"></i>
                                </button>

                                <button title="Edit">
                                    <i class="fa fa-pencil"></i>
                                </button>

                                <button title="More">
                                    <i class="fa fa-ellipsis-v"></i>
                                </button>

                            </div>
                        </td>
                    </tr>


                    <tr>
                        <td>
                            <div class="template-cell">

                                <div class="template-avatar">
                                    <i class="fa fa-envelope-o"></i>
                                </div>

                                <div>
                                    <div class="template-name">
                                        Follow Up Email
                                    </div>

                                    <div class="template-description">
                                        Customer follow up template
                                    </div>
                                </div>

                            </div>
                        </td>

                        <td>
                            <span class="template-subject">
                                Following up regarding your request
                            </span>
                        </td>

                        <td>
                            <span class="template-user">
                                Utkarsh
                            </span>
                        </td>

                        <td>
                            <span class="template-date">
                                01 Aug 2026
                            </span>
                        </td>

                        <td>
                            <span class="template-status active">
                                <span></span>
                                Active
                            </span>
                        </td>

                        <td>
                            <div class="template-actions">
                                <button title="View">
                                    <i class="fa fa-eye"></i>
                                </button>

                                <button title="Edit">
                                    <i class="fa fa-pencil"></i>
                                </button>

                                <button title="More">
                                    <i class="fa fa-ellipsis-v"></i>
                                </button>
                            </div>
                        </td>
                    </tr>


                    <tr>
                        <td>
                            <div class="template-cell">

                                <div class="template-avatar">
                                    <i class="fa fa-envelope-o"></i>
                                </div>

                                <div>
                                    <div class="template-name">
                                        Payment Reminder
                                    </div>

                                    <div class="template-description">
                                        Payment reminder template
                                    </div>
                                </div>

                            </div>
                        </td>

                        <td>
                            <span class="template-subject">
                                Reminder regarding pending payment
                            </span>
                        </td>

                        <td>
                            <span class="template-user">
                                Admin
                            </span>
                        </td>

                        <td>
                            <span class="template-date">
                                30 Jul 2026
                            </span>
                        </td>

                        <td>
                            <span class="template-status inactive">
                                <span></span>
                                Inactive
                            </span>
                        </td>

                        <td>
                            <div class="template-actions">
                                <button title="View">
                                    <i class="fa fa-eye"></i>
                                </button>

                                <button title="Edit">
                                    <i class="fa fa-pencil"></i>
                                </button>

                                <button title="More">
                                    <i class="fa fa-ellipsis-v"></i>
                                </button>
                            </div>
                        </td>
                    </tr>


                    <tr>
                        <td>
                            <div class="template-cell">

                                <div class="template-avatar">
                                    <i class="fa fa-envelope-o"></i>
                                </div>

                                <div>
                                    <div class="template-name">
                                        Account Verification
                                    </div>

                                    <div class="template-description">
                                        Account verification template
                                    </div>
                                </div>

                            </div>
                        </td>

                        <td>
                            <span class="template-subject">
                                Verify your account
                            </span>
                        </td>

                        <td>
                            <span class="template-user">
                                Admin
                            </span>
                        </td>

                        <td>
                            <span class="template-date">
                                28 Jul 2026
                            </span>
                        </td>

                        <td>
                            <span class="template-status active">
                                <span></span>
                                Active
                            </span>
                        </td>

                        <td>
                            <div class="template-actions">
                                <button title="View">
                                    <i class="fa fa-eye"></i>
                                </button>

                                <button title="Edit">
                                    <i class="fa fa-pencil"></i>
                                </button>

                                <button title="More">
                                    <i class="fa fa-ellipsis-v"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>


        <!-- Footer -->
        <div class="templates-footer">

            <span>
                Showing <strong>1–4</strong> of <strong>24</strong>
            </span>

            <div class="templates-pagination">

                <button disabled>
                    <i class="fa fa-chevron-left"></i>
                </button>

                <button class="selected">1</button>
                <button>2</button>
                <button>3</button>

                <span>...</span>

                <button>6</button>

                <button>
                    <i class="fa fa-chevron-right"></i>
                </button>

            </div>

        </div>

    </div>

</div>
<link rel="stylesheet" href="~/css/TemplateAndScheduleGrid.css" />