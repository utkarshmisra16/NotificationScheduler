@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="templates-page">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h5 class="templates-title mb-1">Email Templates</h5>
            <span class="templates-subtitle">
                View and manage all your email templates
            </span>
        </div>

        <button type="button" class="btn btn-primary templates-add-btn">
            <i class="fa fa-plus mr-1"></i>
            New Template
        </button>

    </div>


    <!-- Main Card -->
    <div class="templates-card">

        <!-- Top toolbar -->
        <div class="templates-toolbar">

            <div class="templates-toolbar-left">

                <div class="templates-search">
                    <i class="fa fa-search"></i>
                    <input type="text" placeholder="Search templates..." />
                </div>

                <button type="button" class="templates-filter">
                    <i class="fa fa-filter mr-1"></i>
                    Filter
                </button>

            </div>

            <div class="templates-count">
                <span>24</span> Templates
            </div>

        </div>


        <!-- Table -->
        <div class="templates-table-container">

            <table class="templates-table">

                <thead>
                    <tr>
                        <th>Template</th>
                        <th>Subject</th>
                        <th>Created By</th>
                        <th>Created On</th>
                        <th>Status</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>

                <tbody id="templateTableBody">
                </tbody>

            </table>

        </div>


        <!-- Footer -->
        <div class="templates-footer">

            <span>
                Showing <strong>1–4</strong> of <strong>24</strong>
            </span>

            <div class="templates-pagination">

                <button disabled>
                    <i class="fa fa-chevron-left"></i>
                </button>

                <button class="selected">1</button>
                <button>2</button>
                <button>3</button>

                <span>...</span>

                <button>6</button>

                <button>
                    <i class="fa fa-chevron-right"></i>
                </button>

            </div>

        </div>

    </div>

</div>
<link rel="stylesheet" href="~/css/TemplateAndScheduleGrid.css" />
<script src="~/js/viewTemplatesAndSchedules.js"></script>