@* #region CSS *@
    <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
        <link rel="stylesheet" href="~/css/Dashboard/CreateTemplate.css" />
    <!-- Quill CDN -->
        <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
@* #endregion *@

<div class="dash-page">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 style="font-size:20px;font-weight:700;color:#0f172a;margin-bottom:3px;">Create Template</h1>
            <p style="font-size:13px;color:#64748b;margin:0;">Create a reusable email template for your schedules.</p>
        </div>
        <nav style="font-size:12px;color:#94a3b8;">
            <a href="/Dashboard/Dashboard/Index" style="color:#4f6ef7;text-decoration:none;">Dashboard</a>
            <span class="mx-1">/</span>
            <span style="color:#374151;font-weight:600;">Create Template</span>
        </nav>
    </div>

    <div class="form-card">

        <!-- Template Details -->
        <div class="section-divider">Template Details</div>
        <div class="mb-3">
            <label class="form-label">Template Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" placeholder="e.g. Weekly Newsletter, OTP Verification" />
        </div>
        <div class="mb-4">
            <label class="form-label">Subject <span class="text-danger">*</span></label>
            <input type="text" class="form-control" placeholder="Enter email subject line" />
        </div>

        <!-- Recipients -->
        <div class="section-divider">Recipients</div>
        <div class="mb-3">
            <label class="form-label">To <span class="text-danger">*</span></label>
            <input type="text" class="form-control" placeholder="user1@example.com, user2@example.com" />
            <div class="form-text">Separate multiple emails with commas.</div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">CC <span style="color:#94a3b8;font-weight:400;">(Optional)</span></label>
                <input type="text" class="form-control" placeholder="cc@example.com" />
            </div>
            <div class="col-md-6">
                <label class="form-label">BCC <span style="color:#94a3b8;font-weight:400;">(Optional)</span></label>
                <input type="text" class="form-control" placeholder="bcc@example.com" />
            </div>
        </div>

        <!-- Email Body -->
        <div class="section-divider">Email Body</div>
        <div class="mb-4">
            <label class="form-label">Body <span class="text-danger">*</span></label>
            <div class="quill-wrapper">
                <div id="quill-editor"></div>
            </div>
            <input type="hidden" id="bodyContent" name="Body" />
            <div class="form-text">Use the toolbar to format text, add links, lists, and more.</div>
        </div>

        <!-- Attachments -->
        <div class="section-divider">Attachments</div>
        <div class="mb-4">
            <label class="form-label">Files <span style="color:#94a3b8;font-weight:400;">(Optional)</span></label>
            <div class="drop-zone" id="dropZone">
                <input type="file" id="attachmentInput" multiple
                       accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.txt,.csv,.zip" />
                <div class="dz-icon"><i class="bi bi-cloud-arrow-up"></i></div>
                <div class="dz-title">Drop files here or click to browse</div>
                <div class="dz-sub">PDF, DOC, XLS, PNG, JPG, ZIP &mdash; max 10MB per file</div>
            </div>
            <div class="file-list" id="fileList"></div>
        </div>

        <!-- Schedule & Options -->
        <div class="section-divider">Schedule & Options</div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Schedule Date & Time <span class="text-danger">*</span></label>
                <input type="datetime-local" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Retry Count <span style="color:#94a3b8;font-weight:400;">(on failure)</span></label>
                <input type="number" class="form-control" value="3" min="0" max="10" />
                <div class="form-text">How many times to retry if sending fails.</div>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex justify-content-between align-items-center" style="border-top:1px solid #f1f5f9;padding-top:20px;">
            <a href="/Dashboard/Dashboard/Index" class="btn-cancel">Cancel</a>
            <button class="btn-create" onclick="submitForm()">
                <i class="bi bi-file-earmark-check"></i> Create Template
            </button>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="~/js/Dashboard/CreateTemplate.js"></script>

