@model EmailSchedulerApp.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-box">

    <div class="auth-box-header">
        <h2>Reset Password 🔐</h2>
        <p>Enter your new password below.</p>
    </div>

    <form asp-action="ResetPassword"
          asp-controller="Auth"
          method="post">

        <input type="hidden" asp-for="Token" />

        <div class="form-group">
            <label asp-for="NewPassword">
                New Password
            </label>

            <input asp-for="NewPassword"
                   class="form-control"
                   type="password"
                   placeholder="Enter new password" />

            <span asp-validation-for="NewPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword">
                Confirm Password
            </label>

            <input asp-for="ConfirmPassword"
                   class="form-control"
                   type="password"
                   placeholder="Confirm new password" />

            <span asp-validation-for="ConfirmPassword"
                  class="text-danger">
            </span>
        </div>

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <button type="submit"
                class="btn btn-primary">
            Reset Password
        </button>

    </form>

</div>