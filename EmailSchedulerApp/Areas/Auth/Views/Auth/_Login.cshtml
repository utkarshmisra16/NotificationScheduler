
        <!-- RIGHT PANEL -->
        <div class="auth-box">

            <div class="auth-box-header">
                <h2>Welcome back 👋</h2>
                <p>Login to your account to continue</p>
            </div>

            <!-- Display Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <p class="mb-1">@error.ErrorMessage</p>
                            }
                        }
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="auth-card">
                <form method="post" id="loginForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="Username" class="form-label-sm">Username</label>
                        <div class="input-icon-wrap">
                            <i class="bi bi-person input-icon"></i>
                            <input type="text"
                                   id="Username"
                                   name="Username"
                                   class="form-control"
                                   placeholder="Enter your username"
                                   required
                                   autocomplete="username"
                                   aria-label="Username" />
                            <div class="invalid-feedback">
                                Please provide a valid username.
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label-sm">Password</label>
                        <div class="input-icon-wrap">
                            <i class="bi bi-lock input-icon"></i>
                            <input type="password"
                                   id="password"
                                   name="Password"
                                   class="form-control"
                                   placeholder="Enter your password"
                                   required
                                   autocomplete="current-password"
                                   aria-label="Password" />
                            <button type="button" 
                                    class="toggle-pwd" 
                                    aria-label="Toggle password visibility"
                                    aria-pressed="false"
                                    data-toggle-target="password"
                                    tabindex="-1">
                                <i class="bi bi-eye" id="toggleIcon" aria-hidden="true"></i>
                            </button>
                            <div class="invalid-feedback">
                                Please provide a password.
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check mb-0">
                            <input class="form-check-input" 
                                   type="checkbox" 
                                   id="rememberMe"
                                   name="RememberMe" />
                            <label class="form-check-label" for="rememberMe">
                                Remember me
                            </label>
                        </div>
                        <a href="@Url.Action("ForgotPassword")" class="forgot-link" aria-label="Forgot your password?">
                            Forgot password?
                        </a>
                    </div>

                    <button type="submit" class="btn btn-login w-100">
                        <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>
                        <span>Login</span>
                    </button>

                </form>

                <div class="text-center mt-3 small text-muted">
                    Don't have an account? 
                    <a href="#" id="signUp" class="text-decoration-none">
                        Sign up here
                    </a>
                </div>
            </div>

        </div>

        