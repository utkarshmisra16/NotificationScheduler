@{
    ViewBag.Title = "QueueIt | Logs";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="mb-1">Email Logs</h3>
            <p class="text-secondary mb-0">
                View email execution history and troubleshoot failures.
            </p>
        </div>

        <button type="button" class="btn btn-outline-secondary"
                onclick="location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i>
            Refresh
        </button>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-12 col-md-6 col-lg-4">
                    <label for="searchLogs" class="form-label">
                        Search
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchLogs"
                               class="form-control"
                               placeholder="Subject or recipient">
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <label for="fromDate" class="form-label">
                        From Date
                    </label>
                    <input type="date" id="fromDate"
                           class="form-control">
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <label for="toDate" class="form-label">
                        To Date
                    </label>
                    <input type="date" id="toDate"
                           class="form-control">
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label for="statusFilter" class="form-label">
                        Status
                    </label>
                    <select id="statusFilter" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Sent">Sent</option>
                        <option value="Failed">Failed</option>
                        <option value="Pending">Pending</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <button type="button" id="resetFilters"
                            class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-circle me-1"></i>
                        Clear Filters
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Logs Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex flex-wrap
                    justify-content-between align-items-center gap-2">
            <h5 class="mb-0">Execution History</h5>
            <span class="text-secondary small" id="resultsCount"></span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-3">Timestamp</th>
                            <th>Subject</th>
                            <th>Recipient</th>
                            <th>Status</th>
                            <th>Error Details</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody id="logsTableBody"></tbody>
                </table>
            </div>

            <div id="emptyState" class="text-center py-5 d-none">
                <i class="bi bi-inbox fs-1 text-secondary"></i>
                <h6 class="mt-3">No logs found</h6>
                <p class="text-secondary mb-0">
                    Try changing your search or filters.
                </p>
            </div>
        </div>

        <!-- Pagination -->
        <div class="card-footer bg-white d-flex flex-wrap
                    justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <label for="pageSize" class="text-secondary small">
                    Rows per page
                </label>
                <select id="pageSize" class="form-select form-select-sm"
                        style="width: 75px;">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                </select>
            </div>

            <nav aria-label="Logs pagination">
                <ul class="pagination pagination-sm mb-0"
                    id="pagination"></ul>
            </nav>
        </div>
    </div>

</div>

<!-- Log Details Modal -->
<div class="modal fade" id="logDetailsModal"
     tabindex="-1" aria-labelledby="logDetailsTitle"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="logDetailsTitle">
                    Execution Details
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body" id="logDetailsBody"></div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    // Sample frontend data. Replace with API/database data later.
    const logs = [
        {
            id: 1001,
            timestamp: "2026-10-19T10:30:00",
            subject: "Weekly Team Report",
            recipient: "team@example.com",
            status: "Sent",
            error: ""
        },
        {
            id: 1002,
            timestamp: "2026-10-19T10:15:00",
            subject: "Monthly Invoice",
            recipient: "client@example.com",
            status: "Failed",
            error: "SMTP authentication failed."
        },
        {
            id: 1003,
            timestamp: "2026-10-19T09:45:00",
            subject: "Welcome Email",
            recipient: "user@example.com",
            status: "Sent",
            error: ""
        },
        {
            id: 1004,
            timestamp: "2026-10-18T16:20:00",
            subject: "Daily Summary",
            recipient: "admin@example.com",
            status: "Pending",
            error: ""
        },
        {
            id: 1005,
            timestamp: "2026-10-18T14:10:00",
            subject: "Payment Confirmation",
            recipient: "customer@example.com",
            status: "Failed",
            error: "Recipient server rejected the message."
        },
        {
            id: 1006,
            timestamp: "2026-10-17T11:00:00",
            subject: "Weekly Newsletter",
            recipient: "subscriber@example.com",
            status: "Sent",
            error: ""
        },
        {
            id: 1007,
            timestamp: "2026-10-17T09:30:00",
            subject: "Account Notification",
            recipient: "user@example.com",
            status: "Sent",
            error: ""
        },
        {
            id: 1008,
            timestamp: "2026-10-16T15:45:00",
            subject: "Meeting Reminder",
            recipient: "team@example.com",
            status: "Failed",
            error: "Connection timed out."
        },
        {
            id: 1009,
            timestamp: "2026-10-16T12:00:00",
            subject: "Order Update",
            recipient: "customer@example.com",
            status: "Sent",
            error: ""
        },
        {
            id: 1010,
            timestamp: "2026-10-15T10:00:00",
            subject: "Daily Summary",
            recipient: "admin@example.com",
            status: "Pending",
            error: ""
        },
        {
            id: 1011,
            timestamp: "2026-10-14T13:20:00",
            subject: "Invoice Reminder",
            recipient: "client@example.com",
            status: "Sent",
            error: ""
        },
        {
            id: 1012,
            timestamp: "2026-10-13T09:15:00",
            subject: "System Alert",
            recipient: "admin@example.com",
            status: "Failed",
            error: "SMTP connection could not be established."
        }
    ];

    let currentPage = 1;

    const searchInput = document.getElementById("searchLogs");
    const fromDateInput = document.getElementById("fromDate");
    const toDateInput = document.getElementById("toDate");
    const statusInput = document.getElementById("statusFilter");
    const pageSizeInput = document.getElementById("pageSize");
    const tableBody = document.getElementById("logsTableBody");
    const pagination = document.getElementById("pagination");
    const emptyState = document.getElementById("emptyState");
    const resultsCount = document.getElementById("resultsCount");

    function escapeHtml(value) {
        return String(value ?? "").replace(/[&<>"']/g, character => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
        })[character]);
    }

    function getFilteredLogs() {
        const search = searchInput.value.trim().toLowerCase();
        const fromDate = fromDateInput.value;
        const toDate = toDateInput.value;
        const status = statusInput.value;

        return logs.filter(log => {
            const logDate = log.timestamp.substring(0, 10);

            const matchesSearch =
                log.subject.toLowerCase().includes(search) ||
                log.recipient.toLowerCase().includes(search);

            const matchesStatus = !status || log.status === status;
            const matchesFrom = !fromDate || logDate >= fromDate;
            const matchesTo = !toDate || logDate <= toDate;

            return matchesSearch && matchesStatus &&
                   matchesFrom && matchesTo;
        }).sort((a, b) =>
            new Date(b.timestamp) - new Date(a.timestamp)
        );
    }

    function getStatusBadge(status) {
        const classes = {
            Sent: "text-bg-success",
            Failed: "text-bg-danger",
            Pending: "text-bg-warning"
        };

        return `<span class="badge ${classes[status] || "text-bg-secondary"}">
                    ${escapeHtml(status)}
                </span>`;
    }

    function renderLogs() {
        const filteredLogs = getFilteredLogs();
        const pageSize = Number(pageSizeInput.value);
        const totalPages = Math.ceil(filteredLogs.length / pageSize);

        currentPage = Math.max(1, Math.min(currentPage, totalPages || 1));

        const startIndex = (currentPage - 1) * pageSize;
        const pageLogs = filteredLogs.slice(
            startIndex, startIndex + pageSize
        );

        tableBody.innerHTML = pageLogs.map(log => `
            <tr>
                <td class="px-3 text-nowrap">
                    ${escapeHtml(new Date(log.timestamp).toLocaleString())}
                </td>
                <td>${escapeHtml(log.subject)}</td>
                <td>${escapeHtml(log.recipient)}</td>
                <td>${getStatusBadge(log.status)}</td>
                <td>
                    ${log.error
                        ? `<span class="text-danger small">${escapeHtml(log.error)}</span>`
                        : '<span class="text-secondary">—</span>'}
                </td>
                <td class="text-center">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            data-log-id="${log.id}">
                        <i class="bi bi-eye me-1"></i> View
                    </button>
                </td>
            </tr>
        `).join("");

        emptyState.classList.toggle("d-none", filteredLogs.length > 0);

        resultsCount.textContent = filteredLogs.length
            ? `Showing ${startIndex + 1}–${Math.min(startIndex + pageSize, filteredLogs.length)} of ${filteredLogs.length}`
            : "0 records";

        renderPagination(totalPages);
    }

    function renderPagination(totalPages) {
        if (totalPages <= 1) {
            pagination.innerHTML = "";
            return;
        }

        let html = `
            <li class="page-item ${currentPage === 1 ? "disabled" : ""}">
                <button class="page-link" data-page="${currentPage - 1}"
                        aria-label="Previous page">Previous</button>
            </li>`;

        for (let page = 1; page <= totalPages; page++) {
            html += `
                <li class="page-item ${page === currentPage ? "active" : ""}">
                    <button class="page-link" data-page="${page}">
                        ${page}
                    </button>
                </li>`;
        }

        html += `
            <li class="page-item ${currentPage === totalPages ? "disabled" : ""}">
                <button class="page-link" data-page="${currentPage + 1}"
                        aria-label="Next page">Next</button>
            </li>`;

        pagination.innerHTML = html;
    }

    searchInput.addEventListener("input", () => {
        currentPage = 1;
        renderLogs();
    });

    [fromDateInput, toDateInput, statusInput].forEach(input => {
        input.addEventListener("change", () => {
            currentPage = 1;
            renderLogs();
        });
    });

    pageSizeInput.addEventListener("change", () => {
        currentPage = 1;
        renderLogs();
    });

    pagination.addEventListener("click", event => {
        const button = event.target.closest("button[data-page]");

        if (!button) return;

        const page = Number(button.dataset.page);
        const totalPages = Math.ceil(
            getFilteredLogs().length / Number(pageSizeInput.value)
        );

        if (page >= 1 && page <= totalPages) {
            currentPage = page;
            renderLogs();
        }
    });

    document.getElementById("resetFilters").addEventListener("click", () => {
        searchInput.value = "";
        fromDateInput.value = "";
        toDateInput.value = "";
        statusInput.value = "";
        currentPage = 1;
        renderLogs();
    });

    tableBody.addEventListener("click", event => {
        const button = event.target.closest("button[data-log-id]");

        if (!button) return;

        const log = logs.find(item =>
            item.id === Number(button.dataset.logId)
        );

        if (!log) return;

        document.getElementById("logDetailsBody").innerHTML = `
            <dl class="row mb-0">
                <dt class="col-sm-4">Log ID</dt>
                <dd class="col-sm-8">${log.id}</dd>

                <dt class="col-sm-4">Timestamp</dt>
                <dd class="col-sm-8">
                    ${escapeHtml(new Date(log.timestamp).toLocaleString())}
                </dd>

                <dt class="col-sm-4">Subject</dt>
                <dd class="col-sm-8">${escapeHtml(log.subject)}</dd>

                <dt class="col-sm-4">Recipient</dt>
                <dd class="col-sm-8">${escapeHtml(log.recipient)}</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">${getStatusBadge(log.status)}</dd>

                <dt class="col-sm-4">Error Details</dt>
                <dd class="col-sm-8">
                    ${log.error
                        ? escapeHtml(log.error)
                        : "No error recorded."}
                </dd>
            </dl>`;

        bootstrap.Modal.getOrCreateInstance(
            document.getElementById("logDetailsModal")
        ).show();
    });

    // Prevent selecting an invalid date range.
    fromDateInput.addEventListener("change", () => {
        toDateInput.min = fromDateInput.value || "";
    });

    toDateInput.addEventListener("change", () => {
        fromDateInput.max = toDateInput.value || "";
    });

    renderLogs();
</script>
}