{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EmailSchedulerApp (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/EmailSchedulerApp/bin/Debug/net10.0/EmailSchedulerApp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/EmailSchedulerApp",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/workspaces/NotificationScheduler/EmailSchedulerApp": "${workspaceFolder}/EmailSchedulerApp"
      },
      "preLaunchTask": "build"
    }
  ]
}